Windows Registry Editor Version 5.00

; Till PC - Chrome: no "Save password?" offer, no notifications, no other pop-ups over the billing screen.
; Run once on each till PC as administrator (double-click, Yes), then close ALL Chrome windows and open it again.
; Check: chrome://policy shows the lines below with status OK.
; Applies to every Chrome user on this PC. To undo: delete the key below in regedit.
; (Microsoft Edge instead of Chrome: use Till-Edge-Policy.reg)

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome]
; passwords: never offer to save, never fill a saved one, no "password found in a data breach" warning
"PasswordManagerEnabled"=dword:00000000
"PasswordLeakDetectionEnabled"=dword:00000000
; no address / card suggestions under the scan box and the amount fields
"AutofillAddressEnabled"=dword:00000000
"AutofillCreditCardEnabled"=dword:00000000
; notifications: 2 = block for every site, and never ask
"DefaultNotificationsSetting"=dword:00000002
; other bars that cover the screen
"TranslateEnabled"=dword:00000000
"DefaultBrowserSettingEnabled"=dword:00000000
